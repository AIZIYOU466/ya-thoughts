{
  "quotes": [
    {"id": "q001", "sentence": "长风破浪会有时，直挂云帆济沧海。", "source": "李白《行路难》", "category": "名言", "tags": ["励志", "古诗词"]},
    {"id": "q002", "sentence": "路漫漫其修远兮，吾将上下而求索。", "source": "屈原《离骚》", "category": "名言", "tags": ["求索", "古诗词"]},
    {"id": "q003", "sentence": "天行健，君子以自强不息；地势坤，君子以厚德载物。", "source": "《周易》", "category": "名言", "tags": ["自强", "厚德"]},
    {"id": "q004", "sentence": "宝剑锋从磨砺出，梅花香自苦寒来。", "source": "《警世贤文》", "category": "名言", "tags": ["磨砺", "励志"]},
    {"id": "q005", "sentence": "书山有路勤为径，学海无涯苦作舟。", "source": "韩愈", "category": "名言", "tags": ["勤奋", "学习"]},
    {"id": "q006", "sentence": "业精于勤，荒于嬉；行成于思，毁于随。", "source": "韩愈", "category": "名言", "tags": ["勤奋", "思考"]},
    {"id": "q007", "sentence": "锲而舍之，朽木不折；锲而不舍，金石可镂。", "source": "《荀子·劝学》", "category": "名言", "tags": ["坚持", "古诗词"]},
    {"id": "q008", "sentence": "不积跬步，无以至千里；不积小流，无以成江海。", "source": "《荀子·劝学》", "category": "名言", "tags": ["积累", "古诗词"]},
    {"id": "q009", "sentence": "知之者不如好之者，好之者不如乐之者。", "source": "《论语》", "category": "名言", "tags": ["兴趣", "古诗词"]},
    {"id": "q010", "sentence": "三人行，必有我师焉。", "source": "《论语》", "category": "名言", "tags": ["求知", "古诗词"]},
    {"id": "q011", "sentence": "成功的花，人们只惊羡她现时的明艳！然而当初她的芽儿，浸透了奋斗的泪泉，洒遍了牺牲的血雨。", "source": "冰心《成功的花》", "category": "金句", "tags": ["成功", "奋斗"]},
    {"id": "q012", "sentence": "生活就像海洋，只有意志坚强的人，才能到达彼岸。", "source": "马克思", "category": "金句", "tags": ["坚强", "意志"]},
    {"id": "q013", "sentence": "人生的意义不在于活了多少天，而在于用了多少天。", "source": "汪国真", "category": "金句", "tags": ["人生", "价值"]},
    {"id": "q014", "sentence": "世界上最快乐的事，莫过于为理想而奋斗。", "source": "苏格拉底", "category": "金句", "tags": ["理想", "奋斗"]},
    {"id": "q015", "sentence": "在人生的道路上，谁都会遇到困难和挫折，只要你能在跌倒处重新出发，你就一定能取得最后的胜利。", "source": "张海迪", "category": "金句", "tags": ["挫折", "勇气"]},
    {"id": "q016", "sentence": "失败不是终点，而是通向成功的桥梁。", "source": "戴尔·卡耐基", "category": "金句", "tags": ["失败", "成功"]},
    {"id": "q017", "sentence": "当你觉得孤独的时候，想一想那些曾经和你一起奋斗过的人，你会发现你并不孤单。", "source": "未知", "category": "金句", "tags": ["孤独", "友谊"]},
    {"id": "q018", "sentence": "青春不是年华，而是心境；青春不是桃面丹唇，而是深沉的意志、恢宏的想象。", "source": "塞缪尔·厄尔曼", "category": "金句", "tags": ["青春", "心态"]},
    {"id": "q019", "sentence": "真正的强者，不是压倒一切的人，而是能战胜自己的人。", "source": "杨绛", "category": "金句", "tags": ["自强", "战胜自我"]},
    {"id": "q020", "sentence": "人生就像一本书，平庸者只读封面，有心人会认真读每一页。", "source": "未知", "category": "金句", "tags": ["人生", "态度"]},
    {"id": "q021", "sentence": "钱学森放弃国外优越条件，历经艰辛回国，被誉为“中国导弹之父”。", "source": "事迹", "category": "例证", "tags": ["爱国", "科学家"]},
    {"id": "q022", "sentence": "屠呦呦历经数百次失败，最终提取出青蒿素，拯救了数百万人的生命。", "source": "事迹", "category": "例证", "tags": ["坚持", "科学家"]},
    {"id": "q023", "sentence": "袁隆平扎根田间地头数十年，培育出高产杂交水稻，解决了中国人的吃饭问题。", "source": "事迹", "category": "例证", "tags": ["奉献", "科学家"]},
    {"id": "q024", "sentence": "钟南山在非典和新冠疫情期间，两次逆行出征，守护人民生命健康。", "source": "事迹", "category": "例证", "tags": ["担当", "逆行者"]},
    {"id": "q025", "sentence": "故宫文物修复师十年如一日，用精细的手艺让国宝重获新生。", "source": "事迹", "category": "例证", "tags": ["坚守", "工匠精神"]},
    {"id": "q026", "sentence": "敦煌莫高窟的壁画历经千年风沙，依然色彩斑斓，诉说着历史的沧桑。", "source": "素材", "category": "例证", "tags": ["文化遗产", "历史"]},
    {"id": "q027", "sentence": "从“一带一路”到“人类命运共同体”，中国始终以开放包容的姿态走向世界。", "source": "时政", "category": "例证", "tags": ["开放", "国际合作"]},
    {"id": "q028", "sentence": "绿水青山就是金山银山，生态文明建设让美丽中国更加动人。", "source": "时政", "category": "例证", "tags": ["生态文明", "环保"]},
    {"id": "q029", "sentence": "脱贫攻坚战的胜利，让近1亿农村贫困人口摆脱了绝对贫困，创造了人类减贫史上的奇迹。", "source": "时政", "category": "例证", "tags": ["脱贫", "奇迹"]},
    {"id": "q030", "sentence": "神舟飞天、嫦娥奔月、蛟龙入海，中国科技实力不断提升。", "source": "时政", "category": "例证", "tags": ["科技", "航天"]},
    {"id": "q031", "sentence": "逆行者们用行动诠释：哪有什么岁月静好，不过是有人替你负重前行。", "source": "金句", "category": "金句", "tags": ["奉献", "逆行者"]},
    {"id": "q032", "sentence": "时代是出卷人，我们是答卷人，人民是阅卷人。", "source": "时政", "category": "金句", "tags": ["时代", "担当"]},
